@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Hệ thống gặp sự cố khi xử lý yêu cầu của bạn.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển</h3>
<p>
    Khi bật môi trường <strong>phát triển</strong>, ứng dụng sẽ hiển thị thông tin lỗi chi tiết hơn để hỗ trợ sửa lỗi.
</p>
<p>
    Không nên bật chế độ này trên môi trường triển khai thật vì có thể làm lộ thông tin nhạy cảm cho người dùng.
</p>
